# Copier en `.env` et compléter. NE COMMITTEZ JAMAIS les vraies valeurs.
# Les variables marquées [PROD] sont obligatoires en production.

# --- Base de données (PostgreSQL, y compris en local — ex. base Neon de dev) [PROD]
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/callpme?sslmode=require"

# --- Sécurité [PROD]
# Secret HMAC (cookies admin, jetons de réinitialisation). ≥ 32 caractères.
# Générer : openssl rand -hex 32
NEXTAUTH_SECRET=""
# Segment d'URL secret de la porte admin (/portail/<slug>). Sans lui en prod, la porte est fermée.
ADMIN_GATE_SLUG=""
# Phrase secrète exigée en plus des identifiants admin (recommandée).
ADMIN_PASSPHRASE=""

# --- URL publique (sans slash final)
PUBLIC_URL="http://localhost:3000"

# --- Connexion Google (OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- E-mail (Resend)
RESEND_API_KEY=""
RESEND_FROM="Callpme <noreply@votre-domaine.com>"

# --- Téléphonie (Vapi) — VAPI_WEBHOOK_SECRET obligatoire en prod
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""
VAPI_WEBHOOK_SECRET=""

# --- Paiement (GeniusPay : Mobile Money + carte)
GENIUS_PAY_API_KEY=""
GENIUS_PAY_API_SECRET=""

# --- IA / LLM (configurable par agent)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
MISTRAL_API_KEY=""
PUTER_MODEL=""

# --- Voix (TTS)
ELEVENLABS_API_KEY=""
CARTESIA_API_KEY=""
