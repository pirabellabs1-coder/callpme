# Copier en `.env` et compléter. NE COMMITTEZ JAMAIS les vraies valeurs.
# Les variables marquées [PROD] sont obligatoires en production.

# --- Base de données (PostgreSQL, y compris en local — ex. base Neon de dev) [PROD]
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/callpme?sslmode=require"

# --- Sécurité [PROD]
# Secret HMAC (cookies admin, jetons de réinitialisation). ≥ 32 caractères.
# Générer : openssl rand -hex 32
NEXTAUTH_SECRET=""
# Segment d'URL secret de la porte admin (/portail/<slug>). Sans lui en prod, la porte est fermée.
ADMIN_GATE_SLUG=""
# Phrase secrète exigée en plus des identifiants admin (recommandée).
ADMIN_PASSPHRASE=""
# Clé de chiffrement des identifiants tiers stockés en base (≥ 32 caractères).
# À défaut, dérivée de NEXTAUTH_SECRET. Ne pas la changer sans ressaisir les identifiants.
ENCRYPTION_KEY=""

# --- URL publique (sans slash final)
PUBLIC_URL="http://localhost:3000"

# --- Connexion Google (OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- E-mail (Resend)
RESEND_API_KEY=""
RESEND_FROM="Callpme <noreply@votre-domaine.com>"
# Destinataire des formulaires Contact et Partenaires
CONTACT_TO=""
# Dev uniquement : autorise localhost pour tester vos propres webhooks
# ALLOW_PRIVATE_URLS="1"

# --- Moteur vocal Callpme (serveur voice-server/, remplace Vapi)
# URL publique du serveur vocal (WebSocket), ex. wss://voice.votre-domaine.com
VOICE_SERVER_URL=""
VOICE_SERVER_PORT="4100"
VOICE_MAX_SESSIONS="50"
# Appels simultanés max par organisation, et connexions en attente d'authentification
VOICE_MAX_PER_ORG="10"
VOICE_MAX_PENDING="20"
# Transcription temps réel (Deepgram)
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-2"
# Voix : elevenlabs | cartesia (utilise ELEVENLABS_API_KEY / CARTESIA_API_KEY)
VOICE_TTS_PROVIDER="elevenlabs"
# Voix par défaut selon le genre de la voix choisie pour l'agent (ID fournisseur)
VOICE_DEFAULT_FEMALE_ID=""
VOICE_DEFAULT_MALE_ID=""
ELEVENLABS_MODEL="eleven_flash_v2_5"
CARTESIA_MODEL="sonic-2"

# --- Téléphonie : twilio | telnyx
TELEPHONY_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TELNYX_API_KEY=""
TELNYX_TEXML_APP_ID=""
TELNYX_FROM_NUMBER=""
# Clé publique Telnyx (Mission Control > Keys) pour vérifier les webhooks
TELNYX_PUBLIC_KEY=""

# --- Paiement (GeniusPay : Mobile Money + carte)
GENIUS_PAY_API_KEY=""
GENIUS_PAY_API_SECRET=""

# --- IA / LLM (configurable par agent)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
MISTRAL_API_KEY=""
PUTER_MODEL=""

# --- Voix (TTS)
ELEVENLABS_API_KEY=""
CARTESIA_API_KEY=""
