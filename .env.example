# Copier en `.env` et compléter. NE COMMITTEZ JAMAIS les vraies valeurs.
# Les variables marquées [PROD] sont obligatoires en production.

# --- Base de données (PostgreSQL, y compris en local — ex. base Neon de dev) [PROD]
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/callpme?sslmode=require"

# --- Sécurité [PROD]
# Secret HMAC (cookies admin, jetons de réinitialisation). ≥ 32 caractères.
# Générer : openssl rand -hex 32
NEXTAUTH_SECRET=""
# Segment d'URL secret de la porte admin (/portail/<slug>). Sans lui en prod, la porte est fermée.
ADMIN_GATE_SLUG=""
# Phrase secrète exigée en plus des identifiants admin (recommandée).
ADMIN_PASSPHRASE=""
# Clé de chiffrement des identifiants tiers stockés en base (≥ 32 caractères).
# À défaut, dérivée de NEXTAUTH_SECRET. Ne pas la changer sans ressaisir les identifiants.
ENCRYPTION_KEY=""

# --- URL publique (sans slash final)
PUBLIC_URL="http://localhost:3000"

# --- Connexion Google (OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- E-mail (Resend)
RESEND_API_KEY=""
RESEND_FROM="Callpme <noreply@votre-domaine.com>"
# Destinataire des formulaires Contact et Partenaires
CONTACT_TO=""
# Dev uniquement : autorise localhost pour tester vos propres webhooks
# ALLOW_PRIVATE_URLS="1"

# --- Moteur vocal Callpme (serveur voice-server/, remplace Vapi)
# URL publique du serveur vocal (WebSocket), ex. wss://voice.votre-domaine.com
VOICE_SERVER_URL=""
VOICE_SERVER_PORT="4100"
VOICE_MAX_SESSIONS="50"
# Appels simultanés max par organisation, et connexions en attente d'authentification
VOICE_MAX_PER_ORG="10"
VOICE_MAX_PENDING="20"
# Transcription temps réel (Deepgram)
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-2"
# Voix : elevenlabs | cartesia (utilise ELEVENLABS_API_KEY / CARTESIA_API_KEY)
VOICE_TTS_PROVIDER="elevenlabs"
# Voix par défaut selon le genre de la voix choisie pour l'agent (ID fournisseur)
VOICE_DEFAULT_FEMALE_ID=""
VOICE_DEFAULT_MALE_ID=""
ELEVENLABS_MODEL="eleven_flash_v2_5"
# Notes vocales WhatsApp (facultatif, défaut : ELEVENLABS_MODEL). Hors Flash/Turbo v2.5, la langue n'est pas imposée.
ELEVENLABS_NOTE_MODEL=""
CARTESIA_MODEL="sonic-2"

# --- Langues locales (docs/langues-locales.md). Chaque fournisseur reste éteint sans sa clé.
# Langues ouvertes aux clients dans l'assistant (après test d'un appel) : ex. "yo-NG,ha-NG,wo-SN".
# Lue au build Vercel : redéployer après modification. Retirer une langue empêche de modifier les agents qui l'utilisent.
NEXT_PUBLIC_VOICE_LOCAL_LANGUAGES=""
# Spitch : voix (et transcription) yoruba / haoussa
SPITCH_API_KEY=""
SPITCH_VOICE_YO="sade"
SPITCH_VOICE_HA="amina"
# Google Speech-to-Text v2 (Chirp 3) : JSON du compte de service (brut ou base64)
GOOGLE_STT_CREDENTIALS=""
GOOGLE_STT_PROJECT=""
GOOGLE_STT_LOCATION="us"
# Forcer un fournisseur de transcription par langue : elevenlabs | google | spitch
VOICE_STT_YO=""
# Modèles ElevenLabs pour les langues locales (défaut : eleven_v3 ; wolof : eleven_v4_turbo)
ELEVENLABS_MODEL_YO=""
ELEVENLABS_MODEL_HA=""
ELEVENLABS_MODEL_WO=""

# --- Téléphonie : twilio | telnyx | sip
TELEPHONY_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Achat de numéros : dossier réglementaire (France, Belgique, Suisse…) chez Twilio
TWILIO_ADDRESS_SID=""
TWILIO_BUNDLE_SID=""
TELNYX_API_KEY=""
TELNYX_TEXML_APP_ID=""
TELNYX_FROM_NUMBER=""
# Clé publique Telnyx (Mission Control > Keys) pour vérifier les webhooks
TELNYX_PUBLIC_KEY=""
# SMS (confirmations de rendez-vous) : numéro expéditeur si différent du numéro d'appel
TWILIO_SMS_FROM=""
TELNYX_SMS_FROM=""
TELNYX_MESSAGING_PROFILE_ID=""
# Passerelle SIP Callpme (Asterisk) : opérateur local sans Twilio ni Telnyx.
# Voir infra/asterisk et DEPLOY.md. Secret partagé avec extensions.conf (24 caractères min.).
ASTERISK_ARI_URL=""
ASTERISK_ARI_USER=""
ASTERISK_ARI_PASSWORD=""
SIP_GATEWAY_SECRET=""
# Facultatif : IP de l'Asterisk autorisées à appeler /api/telephony/sip/*
SIP_GATEWAY_ALLOW=""
SIP_FROM_NUMBER=""
# Port du serveur vocal pour Asterisk (vide = désactivé) et IP de l'Asterisk (obligatoire)
VOICE_AUDIOSOCKET_PORT=""
VOICE_AUDIOSOCKET_ALLOW=""
# Base de connaissances : recherche par le sens si OPENAI_API_KEY est défini
# (sinon recherche plein texte en français, sans configuration).
EMBEDDING_MODEL="text-embedding-3-small"
# Campagnes : le serveur vocal cadence les appels toutes les 30 s (VOICE_CAMPAIGN_TICK=0 pour désactiver).
# Relais facultatif par cron : GET /api/cron/campaigns avec « Authorization: Bearer CRON_SECRET ».
VOICE_CAMPAIGN_TICK="1"
CRON_SECRET=""

# --- Paiement (GeniusPay : Mobile Money + carte)
GENIUS_PAY_API_KEY=""
GENIUS_PAY_API_SECRET=""

# --- IA / LLM (configurable par agent)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
MISTRAL_API_KEY=""
PUTER_MODEL=""

# --- Voix (TTS)
ELEVENLABS_API_KEY=""
CARTESIA_API_KEY=""

# Factures : vendeur affiché (raison sociale, adresse, IFU / n° fiscal, e-mail)
INVOICE_SELLER_NAME=""
INVOICE_SELLER_ADDRESS=""
INVOICE_SELLER_TAX_ID=""
INVOICE_SELLER_EMAIL=""

# Vente de numéros par la plateforme (compte opérateur Callpme). Coupée par défaut : les clients apportent leur numéro.
# PLATFORM_NUMBER_SALES=on
