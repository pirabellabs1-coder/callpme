# --- Callpme — variables d'environnement de PRODUCTION (Vercel) ---
# Copiez ces clés dans Vercel → Project → Settings → Environment Variables.
# NE COMMITTEZ JAMAIS les vraies valeurs.

# ===== Obligatoires =====
# Base PostgreSQL (Neon : URL « pooled », région UE)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Secret HMAC, ≥ 32 caractères (openssl rand -hex 32)
NEXTAUTH_SECRET=""
# URL publique du site (sans slash final)
PUBLIC_URL="https://votre-domaine.com"
# Porte admin secrète : /portail/<ADMIN_GATE_SLUG>
ADMIN_GATE_SLUG=""
# Chiffrement des identifiants tiers, ≥ 32 caractères — ne pas changer ensuite
ENCRYPTION_KEY=""

# ===== Recommandées / selon les fonctionnalités =====
ADMIN_PASSPHRASE=""

# E-mails (Resend) — adresse d'un domaine vérifié
RESEND_API_KEY=""
RESEND_FROM="Callpme <noreply@votre-domaine.com>"
# Destinataire des formulaires Contact et Partenaires
CONTACT_TO="contact@votre-domaine.com"

# Moteur vocal Callpme (serveur voice-server/, remplace Vapi)
# URL publique du serveur vocal (WebSocket), ex. wss://voice.votre-domaine.com
VOICE_SERVER_URL=""
VOICE_SERVER_PORT="4100"
VOICE_MAX_SESSIONS="50"
# Appels simultanés max par organisation, et connexions en attente d'authentification
VOICE_MAX_PER_ORG="10"
VOICE_MAX_PENDING="20"
# Transcription temps réel (Deepgram)
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-2"
# Voix : elevenlabs | cartesia (utilise ELEVENLABS_API_KEY / CARTESIA_API_KEY)
VOICE_TTS_PROVIDER="elevenlabs"
# Voix par défaut selon le genre de la voix choisie pour l'agent (ID fournisseur)
VOICE_DEFAULT_FEMALE_ID=""
VOICE_DEFAULT_MALE_ID=""
ELEVENLABS_MODEL="eleven_flash_v2_5"
CARTESIA_MODEL="sonic-2"

# Téléphonie : twilio | telnyx
TELEPHONY_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TELNYX_API_KEY=""
TELNYX_TEXML_APP_ID=""
TELNYX_FROM_NUMBER=""
# Clé publique Telnyx (Mission Control > Keys) pour vérifier les webhooks
TELNYX_PUBLIC_KEY=""
# SMS (confirmations de rendez-vous) : numéro expéditeur si différent du numéro d'appel
TWILIO_SMS_FROM=""
TELNYX_SMS_FROM=""
TELNYX_MESSAGING_PROFILE_ID=""
# Base de connaissances : recherche par le sens si OPENAI_API_KEY est défini
# (sinon recherche plein texte en français, sans configuration).
EMBEDDING_MODEL="text-embedding-3-small"

# Paiements (GeniusPay : Mobile Money + carte)
GENIUS_PAY_API_KEY=""
GENIUS_PAY_API_SECRET=""

# Connexion Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LLM et voix
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
MISTRAL_API_KEY=""
ELEVENLABS_API_KEY=""
CARTESIA_API_KEY=""
