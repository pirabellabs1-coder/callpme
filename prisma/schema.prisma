// Schéma Prisma Callpme.
//
// En local : SQLite (zéro Docker, démarrage immédiat).
// Les champs riches (config d'agent, transcript) sont stockés en TEXT JSON
// pour une portabilité totale ; sur PostgreSQL ils deviennent `Json`/`jsonb`.
// La (dé)sérialisation typée est gérée dans `src/lib/db` — les types métier
// (`AgentConfig`, `TranscriptTurn[]`) restent la source de vérité.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  plan           String               @default("starter") // starter | pro | agency
  /** Fin de la période payée (chaque paiement ajoute 30 jours). */
  paidUntil      DateTime?
  /** Fin de l'essai gratuit (défaut : création + 14 jours). */
  trialEndsAt    DateTime?
  /// Crédit prépayé des appels sortants, en centimes d'euro (jamais négatif).
  callCreditCents Int @default(0)
  /// Échéance (paidUntil) pour laquelle le rappel « fin d'offre » a été envoyé.
  expiryReminderFor DateTime?
  /// Échéance pour laquelle l'avis « offre arrivée à échéance » a été envoyé.
  expiredNoticeFor  DateTime?
  /// Coordonnées de facturation du client (affichées sur ses factures).
  billingName    String?
  billingAddress String?
  billingTaxId   String?
  /** Réglages des alertes au propriétaire (JSON, voir src/lib/alerts). */
  alerts         String?
  /** Pays (ISO) : format des numéros saisis sans indicatif, fuseau par défaut. */
  country        String               @default("FR")
  /** Minutes rechargées (Mobile Money), utilisées après celles de l'offre. */
  extraMinutes   Int                  @default(0)
  /** Marque blanche (agence) : nom et logo affichés sur le portail des clients. */
  brandName      String?
  brandLogoUrl   String?
  /** Domaine personnalisé du portail (ex. espace.monagence.bj). */
  customDomain   String?              @unique
  /** Propriété du domaine prouvée par un enregistrement DNS TXT (sinon ignoré). */
  customDomainVerifiedAt DateTime?
  agents         Agent[]
  users          User[]
  invitations    Invitation[]
  whatsapp       WhatsAppChannel?
  conversations  Conversation[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  customTools    CustomTool[]
  phoneNumbers   PhoneNumber[]
  providers      ProviderConnection[]
  clients        Client[]
  campaigns      Campaign[]
  knowledgeBases KnowledgeBase[]
  voices         Voice[]
  notifications  Notification[]
  integrations   Integration[]
  payments       Payment[]
  agencyRequests AgencyRequest[]
  numberRequests NumberRequest[]
  appointments   Appointment[]
  leads          Lead[]
  callbacks      Callback[]
  paymentSettings PaymentSettings?
  paymentRequests PaymentRequest[]
  createdAt      DateTime             @default(now())
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String? // scrypt: "scrypt$salt$hash"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member
  isAdmin        Boolean      @default(false) // super-admin plateforme
  /** Accès client d'une agence : ne voit que l'espace de ce client (portail). */
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessions       Session[]
  createdAt      DateTime     @default(now())
  // Double authentification (TOTP) : secret chiffré (AES-GCM), codes de secours hachés (JSON).
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?
  /** Dernier pas de temps TOTP accepté : un code ne sert qu'une fois. */
  twoFactorLastStep    Int?
  /** Échecs de code consécutifs et verrouillage (partagés entre toutes les instances). */
  twoFactorFailedCount Int       @default(0)
  twoFactorLockedUntil DateTime?

  @@index([organizationId])
}

/// Invitation à rejoindre une organisation (lien à usage unique, 7 jours).
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("member") // admin | member | client
  /** Invitation au portail d'un client de l'agence. */
  clientId       String?
  /** Empreinte SHA-256 du jeton envoyé par e-mail (le jeton n'est jamais stocké). */
  tokenHash      String       @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String // partie visible, ex: cpk_live_8Fz3
  lastFour       String
  hash           String       @unique // sha256 de la clé complète
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([hash])
}

model Webhook {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  events         String // JSON: string[] (ex: ["agent.created"])
  secret         String // pour la signature HMAC
  enabled        Boolean      @default(true)
  lastStatus     Int?
  lastDeliveryAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Agent {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  knowledgeBaseId String?
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  name            String
  role            String // support | appointment | lead_qualification | outbound_sales | receptionist | survey | custom
  status          String         @default("draft") // active | paused | draft
  config          String // JSON: AgentConfig (voice, model, prompt, tools, guardrails)
  phoneNumber     String?        @unique
  calls           Call[]
  versions        AgentVersion[]
  campaigns       Campaign[]
  appointments    Appointment[]
  leads           Lead[]
  testScenarios   TestScenario[]
  callbacks       Callback[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([role])
}

model Call {
  id             String      @id @default(cuid())
  agentId        String
  agent          Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  direction      String // inbound | outbound
  fromNumber     String
  toNumber       String
  status         String // completed | transferred | failed | missed | in_progress
  durationSec    Int         @default(0)
  transcript     String // JSON: TranscriptTurn[]
  audioUrl       String? // enregistrement réel de l'appel (data URL), si capté
  providerCallId String?     @unique // identifiant de l'appel chez l'opérateur téléphonique
  /** Test A/B : variante de l'agent utilisée pour cet appel (A = actuelle, B = version testée). */
  variant        String?
  /** Client de l'agence au moment de l'appel (portail : pas de fuite si l'agent est réattribué). */
  clientId       String?
  /// JSON : qualité technique (temps de réponse, interruptions, pannes). Voir voice-engine/quality.ts.
  quality        String?
  /// JSON : coût réel de l'appel (tokens, caractères de voix, durée, coût par poste). Voir costs/meter.ts.
  costs          String?
  summary        String?
  outcome        String?
  /// JSON : données relevées en fin d'appel (champs définis sur l'agent).
  extracted      String?
  satisfaction   Int? // 1..5
  createdAt      DateTime    @default(now())
  evaluation     Evaluation?

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

// Fonction personnalisée (function calling) — connectable aux agents.
// Les arguments collectés peuvent être POSTés vers `serverUrl` (endpoint du client).
model CustomTool {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // identifiant technique, ex: collectContact
  label          String
  description    String // pour le LLM
  parameters     String // JSON Schema des arguments
  serverUrl      String? // destination POST des arguments collectés
  secret         String? // signature HMAC de l'appel sortant
  method         String       @default("POST")
  async          Boolean      @default(false) // exécution asynchrone
  strict         Boolean      @default(false) // validation stricte des paramètres
  lockSchema     Boolean      @default(false) // aucune propriété additionnelle
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Numéro de téléphone (importé depuis un provider : Twilio, Zadarma…).
model PhoneNumber {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String       @unique
  label          String
  provider       String // twilio | zadarma | vonage | ovh | telnyx | manual
  monthlyPrice   Float        @default(0)
  status         String       @default("active") // active | pending
  /// Numéro acheté via la plateforme : référence chez l'opérateur (Twilio SID, commande Telnyx).
  providerRef    String?
  /// Acheté via Callpme (true) ou ajouté à la main (à vérifier par l'équipe).
  purchased      Boolean      @default(false)
  /// Compte opérateur du client (ProviderConnection) qui porte ce numéro : appels faits avec ses identifiants.
  connectionId   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----- Marketplace des numéros (numéros fournis par les opérateurs partenaires) -----

// Numéro en stock, mis à disposition par un opérateur partenaire (MTN, Moov…).
model NumberStock {
  id              String   @id @default(cuid())
  number          String   @unique // E.164
  country         String // ISO 3166-1 alpha-2 (BJ, CI…)
  network         String // mtn | moov | celtiis | orange…
  kind            String   @default("mobile") // mobile | fixe
  monthlyPriceXof Int // prix mensuel facturé au client (FCFA)
  setupPriceXof   Int      @default(0) // frais de mise en service (FCFA)
  status          String   @default("available") // available | reserved | assigned | disabled
  /// Demande qui réserve ce numéro (status reserved).
  requestId       String?
  /// Organisation à qui le numéro est attribué (status assigned).
  organizationId  String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([country, network, status])
  @@index([organizationId])
}

// Demande d'achat de numéro d'un client : un numéro du stock, ou une demande
// libre (pays, réseau, préfixe) quand rien n'est disponible.
model NumberRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  country        String
  network        String?
  desiredPrefix  String?
  /// Numéro du stock choisi par le client (null : demande libre).
  stockId        String?
  companyName    String
  contactName    String
  contactPhone   String
  contactEmail   String
  businessId     String? // RCCM ou équivalent
  taxId          String? // IFU ou équivalent
  address        String
  usage          String?
  status         String       @default("pending") // pending | approved | rejected | cancelled
  adminNote      String?
  /// Numéro attribué (texte E.164) une fois la demande validée.
  assignedNumber String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

// Connexion à un opérateur téléphonique (identifiants API).
model ProviderConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String // twilio | zadarma | vonage | ovh | telnyx
  label          String
  accountSid     String?
  authToken      String?
  apiKey         String?
  apiSecret      String?
  /// Empreinte (SHA-256) de l'identifiant de compte : retrouve le compte d'un webhook signé.
  accountKey     String?
  /// Expéditeur des SMS envoyés avec ce compte : numéro SMS (E.164) ou nom (3 à 11 caractères).
  smsSender      String?
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([accountKey])
}

// ----- Espace agence multi-clients (Track 3) -----
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  brandColor     String? // marque blanche
  logoUrl        String?
  contactEmail   String?
  agents         Agent[]
  users          User[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----- Campagnes d'appels sortants (Track 2) -----
model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name           String
  status         String       @default("draft") // draft | running | paused | completed
  /// JSON : CampaignSettings (plages horaires, fuseau, simultanéité, relances).
  settings       String?
  /// Verrou de tour : un seul moteur à la fois compose pour cette campagne.
  tickUntil      DateTime?
  contacts       Contact[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([agentId])
}

model Contact {
  id             String    @id @default(cuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  status         String    @default("pending") // pending | calling | completed | failed | no_answer | opted_out
  outcome        String?
  data           String? // JSON champs additionnels
  calledAt       DateTime?
  providerCallId String?   @unique // appel chez l'opérateur (Twilio CallSid, Telnyx) lié au contact
  /// Tentatives d'appel effectuées, et date de la prochaine relance prévue.
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  createdAt      DateTime  @default(now())

  @@index([campaignId])
  @@index([status])
  @@index([campaignId, status, nextAttemptAt])
  @@index([phone])
}

// ----- Liste d'opposition : numéros à ne jamais appeler (par organisation) -----
model DoNotCall {
  id             String   @id @default(cuid())
  organizationId String
  phone          String // E.164
  reason         String? // demande de l'appelant, import, saisie manuelle
  createdAt      DateTime @default(now())

  @@unique([organizationId, phone])
}

// ----- Base de connaissances / RAG (Track 4) -----
model KnowledgeBase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  documents      Document[]
  agents         Agent[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Document {
  id              String           @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  title           String
  source          String           @default("text") // text | url | pdf | file | site
  /// Adresse d'origine (page web) ou nom du fichier importé.
  origin          String?
  content         String // texte indexé
  status          String           @default("ready") // processing | ready | error
  error           String?
  chunkCount      Int              @default(0)
  chunks          KnowledgeChunk[]
  createdAt       DateTime         @default(now())

  @@index([knowledgeBaseId])
}

/// Passage d'un document (unité de recherche). L'embedding est facultatif :
/// sans clé d'embeddings, la recherche plein texte (français) suffit.
model KnowledgeChunk {
  id              String                       @id @default(cuid())
  documentId      String
  document        Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  position        Int
  content         String
  embedding       Unsupported("vector(1536)")?

  @@index([knowledgeBaseId])
  @@index([documentId])
}

// ----- Studio Voix (entraînement de voix) -----
model Voice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  provider       String       @default("custom") // custom | elevenlabs | azure | playht
  status         String       @default("ready") // training | ready | failed
  gender         String? // feminine | masculine | neutral
  accent         String?
  description    String?
  sampleText     String?
  settings       String? // JSON : { pitch, rate, gain, eqLow, eqMid, eqHigh, reverb, compression, voiceURI }
  sampleUrl      String? // échantillon enregistré (data URL audio) ou rendu traité
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----- Évaluation automatique des appels (bonus) -----
model Evaluation {
  id           String   @id @default(cuid())
  callId       String   @unique
  call         Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  successScore Int // 0..100
  goalAchieved Boolean  @default(false)
  sentiment    String? // positive | neutral | negative
  summary      String?
  createdAt    DateTime @default(now())
}

// ----- Notifications (bonus) -----
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       @default("info") // info | call | campaign | system
  title          String
  body           String?
  href           String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----- Intégrations (bonus) -----
model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String // google_calendar | hubspot | salesforce | pipedrive | slack | zapier
  status         String       @default("connected") // connected | disconnected
  config         String? // JSON
  createdAt      DateTime     @default(now())

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// ----- Codes promo (super-admin) -----
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @default("percent") // percent | amount | plan
  discountValue  Int       @default(0) // % ou € selon le type
  grantPlan      String? // offre offerte (si type = plan)
  maxRedemptions Int       @default(0) // 0 = illimité
  redeemedCount  Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

// ----- Paiements (GeniusPay) -----
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String? // référence GeniusPay
  kind           String // subscription | agency
  plan           String? // starter | pro | agency
  amountEur      Int // montant affiché en euros
  amountXof      Int // montant réellement facturé en FCFA
  status         String       @default("pending") // pending | completed | failed
  /** Code promo utilisé (compté à la confirmation du paiement). */
  promoCode      String?
  /** Recharge : minutes achetées. */
  minutes        Int?
  /** Numéro de facture, attribué à la confirmation (FAC-2026-000001). */
  invoiceNumber  String?      @unique
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([reference])
  /// Montant hors taxes (le montant payé `amountEur` est TTC quand la TVA s'applique).
  amountHtEur    Float?
  /// Instantané figé à l'émission de la facture : vendeur, client, TVA (JSON).
  invoiceData    String?
}

// ----- Demandes d'offre Agence (devis sur-mesure) -----
model AgencyRequest {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactName     String
  contactEmail    String
  objectives      String // objectifs du client
  budgetEur       Int // budget annoncé par le client (€)
  status          String       @default("pending") // pending | quoted | paid | rejected
  quotedAmountEur Int? // montant fixé par l'admin (€)
  adminNote       String? // message de l'admin
  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([status])
}

// ----- Rendez-vous pris par les agents (agenda intégré) -----
model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /** Client de l'agence au moment de la prise de rendez-vous. */
  clientId       String?
  /// Référence courte donnée au client (ex. RDV-4K7P2).
  reference      String       @unique
  customerName   String
  customerPhone  String?
  customerEmail  String?
  notes          String?
  startsAt       DateTime
  durationMin    Int          @default(30)
  status         String       @default("booked") // booked | cancelled
  /// Verrou anti double réservation : "agentId:ISO" tant que le RDV est actif, null une fois annulé.
  slotKey        String?      @unique
  /// Pris pendant un test (navigateur / chat) : pas de SMS, pas de synchronisation.
  isTest         Boolean      @default(false)
  source         String       @default("call") // call | dashboard | api
  callRef        String?
  googleEventId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, startsAt])
  @@index([agentId, startsAt])
  @@index([customerPhone])
}

// ----- Prospects / contacts collectés pendant les appels (mini-CRM) -----
model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /** Client de l'agence au moment de la création. */
  clientId       String?
  name           String
  phone          String?
  email          String?
  notes          String?
  /// Score de qualification 0–100.
  score          Int?
  interest       String? // faible | moyen | fort
  status         String       @default("new") // new | contacted | qualified | won | lost
  kind           String       @default("lead") // lead | message | callback | ticket
  callbackAt     DateTime?
  isTest         Boolean      @default(false)
  callRef        String?
  /// Identifiants dans les CRM externes (JSON : { hubspot, pipedrive }).
  externalIds    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, phone])
}

// ----- Compteurs quotidiens anti-abus (SMS, e-mails envoyés par les agents) -----
model DailyCounter {
  id             String   @id @default(cuid())
  organizationId String
  day            String // AAAA-MM-JJ (UTC ; jour local de l'organisation pour « digest »)
  kind           String // sms | email | … | digest (verrou du résumé quotidien)
  count          Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, day, kind])
}

// ----- Tests par simulation : scénarios rejoués avant mise en ligne -----
model TestScenario {
  id             String    @id @default(cuid())
  organizationId String
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name           String
  /// « persona » : un appelant joué par l'IA ; « script » : répliques fixes.
  mode           String    @default("script")
  /// Persona de l'appelant (mode persona) ou répliques, une par ligne (mode script).
  callerPrompt   String
  /// JSON : attentes (outils à appeler / à éviter, mots à dire / à éviter, critère libre).
  expectations   String
  maxTurns       Int       @default(8)
  runs           TestRun[]
  createdAt      DateTime  @default(now())

  @@index([agentId])
  @@index([organizationId])
}

model TestRun {
  id         String       @id @default(cuid())
  scenarioId String
  scenario   TestScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  passed     Boolean
  /// Part des vérifications réussies (0–100).
  score      Int
  transcript String // JSON : TranscriptTurn[]
  checks     String // JSON : CheckResult[]
  createdAt  DateTime     @default(now())

  @@index([scenarioId, createdAt])
}

// ----- Passerelle SIP (Asterisk) : sessions d'appel préparées -----
// Asterisk demande une session à l'application (appel entrant) ou l'application
// la crée (appel sortant) ; le serveur vocal la consomme une seule fois quand
// Asterisk ouvre le flux audio (AudioSocket) avec cet identifiant.
model SipSession {
  id             String    @id // UUID transmis à AudioSocket
  organizationId String
  agentId        String
  direction      String // inbound | outbound
  fromNumber     String
  toNumber       String
  metadata       String? // JSON : contactId, campaignId, voicemail…
  channelId      String? // canal Asterisk (transfert, raccroché)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

/// Canal WhatsApp Business (API Cloud de Meta) d'une organisation.
model WhatsAppChannel {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /** Agent qui répond sur WhatsApp. */
  agentId        String
  /** Identifiant du numéro chez Meta (« Phone number ID »). */
  phoneNumberId  String       @unique
  displayNumber  String?
  /** Jeton d'accès et secret de l'application Meta, chiffrés (AES-GCM). */
  accessToken    String
  appSecret      String
  /** Jeton de vérification du webhook (généré, à copier chez Meta). */
  verifyToken    String
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

/// Conversation écrite (WhatsApp…) entre un contact et un agent.
model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  channel        String       // whatsapp
  /** Numéro du contact (E.164). */
  contact        String
  contactName    String?
  /** JSON : [{ role: "user" | "agent" | "tool", text, at, kind? }] */
  messages       String       @default("[]")
  /** Dernier message (liste des conversations sans charger tout l'historique). */
  lastText       String?
  /** Compteur de messages du contact sur la journée (limite par contact). */
  dayKey         String?
  dayCount       Int          @default(0)
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([organizationId, channel, contact])
  @@index([organizationId, lastMessageAt])
}

/// Messages déjà traités (Meta renvoie un message tant qu'il n'a pas reçu 200).
model ChannelEvent {
  id        String   @id // identifiant du message chez Meta (wamid)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Version enregistrée de la configuration d'un agent (historique, restauration, test A/B).
model AgentVersion {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  number    Int
  /** Configuration complète (JSON) au moment de l'enregistrement. */
  config    String
  /** Ce qui a changé (résumé lisible). */
  note      String?
  createdAt DateTime @default(now())

  @@unique([agentId, number])
  @@index([agentId, createdAt])
}

// Catalogue de voix de la plateforme (géré dans l'espace administrateur).
// Chaque voix est une vraie voix du fournisseur : l'aperçu entendu par le
// client est exactement la voix entendue au téléphone.
model PlatformVoice {
  id          String   @id @default(cuid())
  name        String
  description String?
  gender      String? // feminine | masculine | neutral
  age         String? // young | middle_aged | old
  accent      String?
  language    String   @default("fr")
  useCase     String?
  provider    String   @default("elevenlabs")
  /// Identifiant de la voix chez le fournisseur (utilisable en synthèse).
  externalId  String   @unique
  previewUrl  String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

// ----- Crédit des appels sortants : réservation par appel -----
// Avant de composer, le crédit est réservé (prélevé) ; à la fin, l'appel est
// réglé sur la durée facturée par l'opérateur et le reste est rendu.
model OutboundHold {
  id             String   @id @default(cuid())
  organizationId String
  to             String
  rateCents      Int
  holdCents      Int
  chargedCents   Int      @default(0)
  /// Durée vue par le moteur vocal (secondes), quand une session s'est ouverte.
  sessionSec     Int?
  providerCallId String?  @unique
  settled        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([settled, createdAt])
}

// ----- Réglages de la plateforme (clé → JSON), ex. informations légales de la société -----
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ----- Rappel automatique des bips et des appels manqués (voir src/lib/callbacks) -----
model Callback {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Numéro à rappeler (E.164).
  phone          String
  /// flash = bip (appel non décroché exprès) ; missed = appelant raccroché avant de parler.
  reason         String
  status         String       @default("pending") // pending | calling | completed | no_answer | failed | expired
  dueAt          DateTime
  attempts       Int          @default(0)
  providerCallId String?      @unique
  outcome        String?
  /// Appel enregistré de la conversation de rappel.
  callId         String?
  createdAt      DateTime     @default(now())

  @@index([status, dueAt])
  @@index([organizationId, phone, createdAt])
  @@index([agentId])
}

/// Encaissement pendant l'appel : compte GeniusPay MARCHAND de l'organisation
/// (l'argent va à l'entreprise, pas à Callpme). Clés chiffrées (AES-GCM).
model PaymentSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(false)
  apiKey         String // chiffré
  apiSecret      String // chiffré
  webhookSecret  String // chiffré : signature HMAC des webhooks GeniusPay
  /// Identifiant public et aléatoire de l'URL du webhook marchand.
  webhookToken   String       @unique
  /// Devise des montants annoncés : XOF (FCFA) ou EUR (converti en XOF).
  currency       String       @default("XOF")
  /// Plafond par demande, dans la devise ci-dessus.
  maxAmount      Int          @default(50000)
  /// L'agent peut-il demander un montant libre (sinon : tarifs ci-dessous seulement) ?
  allowCustomAmount Boolean   @default(false)
  /// JSON : [{ "label": "Consultation", "amount": 5000 }] — tarifs fixés par l'entreprise.
  items          String?
  /// Canal d'envoi du lien : sms | whatsapp (repli SMS si WhatsApp échoue).
  delivery       String       @default("sms")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

/// Demande de paiement créée par un agent pendant un appel.
model PaymentRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  /// Appel : identifiant de session pendant l'appel, puis celui de l'appel enregistré.
  callRef        String?
  amount         Float // dans `currency`
  currency       String // XOF | EUR
  amountXof      Int // montant réellement encaissé
  reason         String
  customerPhone  String
  status         String       @default("pending") // pending | completed | failed
  /// Référence GeniusPay.
  reference      String?      @unique
  checkoutUrl    String?
  channel        String? // sms | whatsapp
  /// Une seule demande pour un même appel, montant et motif.
  idempotencyKey String       @unique
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([callRef])
}

/// ses entraînements et les versions de modèle produites.
model InhouseVoice {
  id          String                @id @default(cuid())
  name        String
  description String?
  gender      String? // feminine | masculine | neutral
  accent      String?
  language    String                @default("fr")
  createdById String
  consent     InhouseVoiceConsent?
  clips       InhouseVoiceClip[]
  jobs        InhouseTrainingJob[]
  versions    InhouseVoiceVersion[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

/// Consentement signé du locuteur. Sans consentement valide (non révoqué) :
/// aucun clip, aucun entraînement, aucune version publiée.
model InhouseVoiceConsent {
  id             String       @id @default(cuid())
  voiceId        String       @unique
  voice          InhouseVoice @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  speakerName    String
  speakerContact String?
  /// Version du modèle de formulaire de consentement signé (ex. "2026-11-v1").
  formVersion    String
  signedAt       DateTime
  /// Formulaire signé (PDF ou photo), conservé comme preuve.
  document       Bytes
  documentMime   String
  documentName   String
  attestedById   String
  attestedAt     DateTime     @default(now())
  revokedAt      DateTime?
  revokeReason   String?
}

/// Clip du jeu de données : un enregistrement court et sa transcription exacte.
model InhouseVoiceClip {
  id              String       @id @default(cuid())
  voiceId         String
  voice           InhouseVoice @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  transcript      String
  audio           Bytes
  mimeType        String
  sizeBytes       Int
  durationMs      Int?
  source          String // upload | record
  /// L'administrateur a attesté que ce clip est la voix du locuteur consentant.
  consentAttested Boolean
  uploadedById    String
  createdAt       DateTime     @default(now())

  @@index([voiceId, createdAt])
}

/// Entraînement (fine-tuning) lancé depuis l'espace admin et exécuté par le
/// serveur d'entraînement GPU (CALLPME_TRAINING_URL).
model InhouseTrainingJob {
  id              String               @id @default(cuid())
  voiceId         String
  voice           InhouseVoice         @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  /// queued | submitted | running | succeeded | failed | canceled
  status          String               @default("queued")
  baseModel       String
  clipCount       Int
  totalDurationMs Int
  progress        Int?
  message         String?
  externalJobId   String?
  createdById     String
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  version         InhouseVoiceVersion?

  @@index([voiceId, createdAt])
  @@index([status])
}

/// Version de modèle produite par un entraînement, servie par le serveur
/// d'inférence (CALLPME_TTS_URL). Publiée = présente au catalogue PlatformVoice.
model InhouseVoiceVersion {
  id              String              @id @default(cuid())
  voiceId         String
  voice           InhouseVoice        @relation(fields: [voiceId], references: [id], onDelete: Cascade)
  jobId           String?             @unique
  job             InhouseTrainingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  number          Int
  /// Référence du modèle chez le serveur d'inférence : `cpm_<jobId>`, attribuée
  /// par Callpme au lancement de l'entraînement. Sert aussi d'identifiant de voix.
  modelRef        String              @unique
  /// draft | published | retired
  status          String              @default("draft")
  notes           String?
  /// Échantillon WAV généré par le serveur d'inférence à la publication.
  sampleAudio     Bytes?
  platformVoiceId String?             @unique
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())

  @@unique([voiceId, number])
}
