// Schéma Prisma Callpme.
//
// En local : SQLite (zéro Docker, démarrage immédiat).
// Les champs riches (config d'agent, transcript) sont stockés en TEXT JSON
// pour une portabilité totale ; sur PostgreSQL ils deviennent `Json`/`jsonb`.
// La (dé)sérialisation typée est gérée dans `src/lib/db` — les types métier
// (`AgentConfig`, `TranscriptTurn[]`) restent la source de vérité.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Organization {
  id             String               @id @default(cuid())
  name           String
  plan           String               @default("starter") // starter | pro | agency
  agents         Agent[]
  users          User[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  customTools    CustomTool[]
  phoneNumbers   PhoneNumber[]
  providers      ProviderConnection[]
  clients        Client[]
  campaigns      Campaign[]
  knowledgeBases KnowledgeBase[]
  voices         Voice[]
  notifications  Notification[]
  integrations   Integration[]
  payments       Payment[]
  agencyRequests AgencyRequest[]
  appointments   Appointment[]
  leads          Lead[]
  createdAt      DateTime             @default(now())
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String? // scrypt: "scrypt$salt$hash"
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member
  isAdmin        Boolean      @default(false) // super-admin plateforme
  sessions       Session[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String // partie visible, ex: cpk_live_8Fz3
  lastFour       String
  hash           String       @unique // sha256 de la clé complète
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([hash])
}

model Webhook {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  events         String // JSON: string[] (ex: ["agent.created"])
  secret         String // pour la signature HMAC
  enabled        Boolean      @default(true)
  lastStatus     Int?
  lastDeliveryAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Agent {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  knowledgeBaseId String?
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  name            String
  role            String // support | appointment | lead_qualification | outbound_sales | receptionist | survey | custom
  status          String         @default("draft") // active | paused | draft
  config          String // JSON: AgentConfig (voice, model, prompt, tools, guardrails)
  phoneNumber     String?        @unique
  calls           Call[]
  campaigns       Campaign[]
  appointments    Appointment[]
  leads           Lead[]
  testScenarios   TestScenario[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([role])
}

model Call {
  id             String      @id @default(cuid())
  agentId        String
  agent          Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  direction      String // inbound | outbound
  fromNumber     String
  toNumber       String
  status         String // completed | transferred | failed | missed | in_progress
  durationSec    Int         @default(0)
  transcript     String // JSON: TranscriptTurn[]
  audioUrl       String? // enregistrement réel de l'appel (data URL), si capté
  providerCallId String?     @unique // identifiant de l'appel chez l'opérateur téléphonique
  summary        String?
  outcome        String?
  /// JSON : données relevées en fin d'appel (champs définis sur l'agent).
  extracted      String?
  satisfaction   Int? // 1..5
  createdAt      DateTime    @default(now())
  evaluation     Evaluation?

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

// Fonction personnalisée (function calling) — connectable aux agents.
// Les arguments collectés peuvent être POSTés vers `serverUrl` (endpoint du client).
model CustomTool {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // identifiant technique, ex: collectContact
  label          String
  description    String // pour le LLM
  parameters     String // JSON Schema des arguments
  serverUrl      String? // destination POST des arguments collectés
  secret         String? // signature HMAC de l'appel sortant
  method         String       @default("POST")
  async          Boolean      @default(false) // exécution asynchrone
  strict         Boolean      @default(false) // validation stricte des paramètres
  lockSchema     Boolean      @default(false) // aucune propriété additionnelle
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Numéro de téléphone (importé depuis un provider : Twilio, Zadarma…).
model PhoneNumber {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String       @unique
  label          String
  provider       String // twilio | zadarma | vonage | ovh | telnyx | manual
  monthlyPrice   Float        @default(0)
  status         String       @default("active") // active | pending
  /// Numéro acheté via la plateforme : référence chez l'opérateur (Twilio SID, commande Telnyx).
  providerRef    String?
  /// Acheté via Callpme (true) ou ajouté à la main (à vérifier par l'équipe).
  purchased      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Connexion à un opérateur téléphonique (identifiants API).
model ProviderConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String // twilio | zadarma | vonage | ovh | telnyx
  label          String
  accountSid     String?
  authToken      String?
  apiKey         String?
  apiSecret      String?
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----- Espace agence multi-clients (Track 3) -----
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  brandColor     String? // marque blanche
  logoUrl        String?
  contactEmail   String?
  agents         Agent[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----- Campagnes d'appels sortants (Track 2) -----
model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name           String
  status         String       @default("draft") // draft | running | paused | completed
  /// JSON : CampaignSettings (plages horaires, fuseau, simultanéité, relances).
  settings       String?
  /// Verrou de tour : un seul moteur à la fois compose pour cette campagne.
  tickUntil      DateTime?
  contacts       Contact[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([agentId])
}

model Contact {
  id             String    @id @default(cuid())
  campaignId     String
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  status         String    @default("pending") // pending | calling | completed | failed | no_answer | opted_out
  outcome        String?
  data           String? // JSON champs additionnels
  calledAt       DateTime?
  providerCallId String?   @unique // appel chez l'opérateur (Twilio CallSid, Telnyx) lié au contact
  /// Tentatives d'appel effectuées, et date de la prochaine relance prévue.
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  createdAt      DateTime  @default(now())

  @@index([campaignId])
  @@index([status])
  @@index([campaignId, status, nextAttemptAt])
  @@index([phone])
}

// ----- Liste d'opposition : numéros à ne jamais appeler (par organisation) -----
model DoNotCall {
  id             String   @id @default(cuid())
  organizationId String
  phone          String // E.164
  reason         String? // demande de l'appelant, import, saisie manuelle
  createdAt      DateTime @default(now())

  @@unique([organizationId, phone])
}

// ----- Base de connaissances / RAG (Track 4) -----
model KnowledgeBase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  documents      Document[]
  agents         Agent[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Document {
  id              String           @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  title           String
  source          String           @default("text") // text | url | pdf | file | site
  /// Adresse d'origine (page web) ou nom du fichier importé.
  origin          String?
  content         String // texte indexé
  status          String           @default("ready") // processing | ready | error
  error           String?
  chunkCount      Int              @default(0)
  chunks          KnowledgeChunk[]
  createdAt       DateTime         @default(now())

  @@index([knowledgeBaseId])
}

/// Passage d'un document (unité de recherche). L'embedding est facultatif :
/// sans clé d'embeddings, la recherche plein texte (français) suffit.
model KnowledgeChunk {
  id              String                       @id @default(cuid())
  documentId      String
  document        Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  position        Int
  content         String
  embedding       Unsupported("vector(1536)")?

  @@index([knowledgeBaseId])
  @@index([documentId])
}

// ----- Studio Voix (entraînement de voix) -----
model Voice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  provider       String       @default("custom") // custom | elevenlabs | azure | playht
  status         String       @default("ready") // training | ready | failed
  gender         String? // feminine | masculine | neutral
  accent         String?
  description    String?
  sampleText     String?
  settings       String? // JSON : { pitch, rate, gain, eqLow, eqMid, eqHigh, reverb, compression, voiceURI }
  sampleUrl      String? // échantillon enregistré (data URL audio) ou rendu traité
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----- Évaluation automatique des appels (bonus) -----
model Evaluation {
  id           String   @id @default(cuid())
  callId       String   @unique
  call         Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  successScore Int // 0..100
  goalAchieved Boolean  @default(false)
  sentiment    String? // positive | neutral | negative
  summary      String?
  createdAt    DateTime @default(now())
}

// ----- Notifications (bonus) -----
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       @default("info") // info | call | campaign | system
  title          String
  body           String?
  href           String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// ----- Intégrations (bonus) -----
model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String // google_calendar | hubspot | salesforce | pipedrive | slack | zapier
  status         String       @default("connected") // connected | disconnected
  config         String? // JSON
  createdAt      DateTime     @default(now())

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// ----- Codes promo (super-admin) -----
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @default("percent") // percent | amount | plan
  discountValue  Int       @default(0) // % ou € selon le type
  grantPlan      String? // offre offerte (si type = plan)
  maxRedemptions Int       @default(0) // 0 = illimité
  redeemedCount  Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

// ----- Paiements (GeniusPay) -----
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reference      String? // référence GeniusPay
  kind           String // subscription | agency
  plan           String? // starter | pro | agency
  amountEur      Int // montant affiché en euros
  amountXof      Int // montant réellement facturé en FCFA
  status         String       @default("pending") // pending | completed | failed
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([reference])
}

// ----- Demandes d'offre Agence (devis sur-mesure) -----
model AgencyRequest {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactName     String
  contactEmail    String
  objectives      String // objectifs du client
  budgetEur       Int // budget annoncé par le client (€)
  status          String       @default("pending") // pending | quoted | paid | rejected
  quotedAmountEur Int? // montant fixé par l'admin (€)
  adminNote       String? // message de l'admin
  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([status])
}

// ----- Rendez-vous pris par les agents (agenda intégré) -----
model Appointment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /// Référence courte donnée au client (ex. RDV-4K7P2).
  reference      String       @unique
  customerName   String
  customerPhone  String?
  customerEmail  String?
  notes          String?
  startsAt       DateTime
  durationMin    Int          @default(30)
  status         String       @default("booked") // booked | cancelled
  /// Verrou anti double réservation : "agentId:ISO" tant que le RDV est actif, null une fois annulé.
  slotKey        String?      @unique
  /// Pris pendant un test (navigateur / chat) : pas de SMS, pas de synchronisation.
  isTest         Boolean      @default(false)
  source         String       @default("call") // call | dashboard | api
  callRef        String?
  googleEventId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, startsAt])
  @@index([agentId, startsAt])
  @@index([customerPhone])
}

// ----- Prospects / contacts collectés pendant les appels (mini-CRM) -----
model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  name           String
  phone          String?
  email          String?
  notes          String?
  /// Score de qualification 0–100.
  score          Int?
  interest       String? // faible | moyen | fort
  status         String       @default("new") // new | contacted | qualified | won | lost
  kind           String       @default("lead") // lead | message | callback | ticket
  callbackAt     DateTime?
  isTest         Boolean      @default(false)
  callRef        String?
  /// Identifiants dans les CRM externes (JSON : { hubspot, pipedrive }).
  externalIds    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, phone])
}

// ----- Compteurs quotidiens anti-abus (SMS, e-mails envoyés par les agents) -----
model DailyCounter {
  id             String   @id @default(cuid())
  organizationId String
  day            String // AAAA-MM-JJ (UTC)
  kind           String // sms | email
  count          Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, day, kind])
}

// ----- Tests par simulation : scénarios rejoués avant mise en ligne -----
model TestScenario {
  id             String    @id @default(cuid())
  organizationId String
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name           String
  /// « persona » : un appelant joué par l'IA ; « script » : répliques fixes.
  mode           String    @default("script")
  /// Persona de l'appelant (mode persona) ou répliques, une par ligne (mode script).
  callerPrompt   String
  /// JSON : attentes (outils à appeler / à éviter, mots à dire / à éviter, critère libre).
  expectations   String
  maxTurns       Int       @default(8)
  runs           TestRun[]
  createdAt      DateTime  @default(now())

  @@index([agentId])
  @@index([organizationId])
}

model TestRun {
  id         String       @id @default(cuid())
  scenarioId String
  scenario   TestScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  passed     Boolean
  /// Part des vérifications réussies (0–100).
  score      Int
  transcript String // JSON : TranscriptTurn[]
  checks     String // JSON : CheckResult[]
  createdAt  DateTime     @default(now())

  @@index([scenarioId, createdAt])
}

// ----- Passerelle SIP (Asterisk) : sessions d'appel préparées -----
// Asterisk demande une session à l'application (appel entrant) ou l'application
// la crée (appel sortant) ; le serveur vocal la consomme une seule fois quand
// Asterisk ouvre le flux audio (AudioSocket) avec cet identifiant.
model SipSession {
  id             String    @id // UUID transmis à AudioSocket
  organizationId String
  agentId        String
  direction      String // inbound | outbound
  fromNumber     String
  toNumber       String
  metadata       String? // JSON : contactId, campaignId, voicemail…
  channelId      String? // canal Asterisk (transfert, raccroché)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}
